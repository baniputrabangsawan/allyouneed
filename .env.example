VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000

APP_ENV=development
APP_NAME=utility-api

LICENSE_DATABASE_URL=sqlite+aiosqlite:///./data/licenses.db
DATABASE_URL=sqlite+aiosqlite:///./data/licenses.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ADMIN_CORS_ORIGINS=["http://localhost:3000"]
ADMIN_SESSION_COOKIE_NAME=kits_admin_session
ADMIN_CSRF_COOKIE_NAME=kits_admin_csrf
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_TOTP_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379/0
ENTITLEMENT_PRIVATE_KEY=
ENTITLEMENT_PUBLIC_KEY=
ENTITLEMENT_KEY_ID=ent-1
ENTITLEMENT_TOKEN_TTL_SECONDS=86400
LICENSE_STATUS_CACHE_TTL_SECONDS=60
AI_CONCURRENT_JOBS=2
VIDEO_CONCURRENT_JOBS=1

R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

FILE_TTL_SECONDS=3600
MAX_UPLOAD_MB=100
MAX_BATCH_FILES=20
MAX_IMAGE_PIXELS=100000000

DEFAULT_JOB_TIMEOUT_SECONDS=300

ENABLE_SELF_HOSTED_AI=true
ENABLE_EXTERNAL_AI=false

STT_PROVIDER=selfhosted
TTS_PROVIDER=selfhosted
# tiny|base|small|medium|large-v3 — downloaded lazily on first STT job, not at API startup
WHISPER_MODEL=small
STT_MAX_DURATION_SECONDS=1800
TTS_MAX_CHARS=5000
# Piper voices: $STORAGE_ROOT/models/tts/<piper_id>.onnx (example: en_US-lessac-medium.onnx)
# Kokoro (optional): $STORAGE_ROOT/models/tts/kokoro-v1.0.onnx and voices-v1.0.bin
BACKGROUND_REMOVAL_PROVIDER=selfhosted
UPSCALE_PROVIDER=selfhosted
OCR_PROVIDER=selfhosted

SENTRY_DSN=
STORAGE_ROOT=.data
PUBLIC_BASE_URL=http://localhost:8000
DOWNLOAD_SIGNING_SECRET=dev-download-secret
DOWNLOAD_URL_TTL_SECONDS=900
INLINE_JOBS=true
